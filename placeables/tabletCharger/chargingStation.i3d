      <CustomParameter name="lightControl" value="1 5 1 7"/>
      <CustomParameter name="colorScale" value="0.02 0.38 0.706 0"/>
      <CustomParameter name="blinkOffset" value="0 0.5 1 7"/>
      <CustomParameter name="blinkSpeed" value="5 1 5 1"/>
