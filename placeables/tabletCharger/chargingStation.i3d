        <Light name="chargeLight" translation="-3.04146e-07 1.51589 -0.069557" rotation="1.7156e-05 0 1.71537e-05" clipDistance="75" nodeId="26" type="point" color="0.023 0.386 0.708" emitDiffuse="true" emitSpecular="true" range="0.7"/>
